# Build-time Vite vars for production builds (vite build → Cloudflare Pages and
# local dev.sh). Public values only. Never put DISCORD_CLIENT_SECRET here; that
# stays a backend-only env var. See DEPLOY.md and wrangler.toml.

# Discord Application ID (= OAuth Client ID). Required by the Discord Activity
# bootstrap (src/lib/activity.ts); the same id the backend uses as DISCORD_CLIENT_ID.
VITE_DISCORD_CLIENT_ID=949001044061454377
