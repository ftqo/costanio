#: src/lib/errorCopy.ts:543
msgid "error.NO_JOURNEY"
msgstr "Uma Jornada veloz é uma segunda viagem, então termine a primeira."

#: src/routes/HowToPlay.tsx:235
msgid "A table setting: the host can change this. See Playing online → Table settings."
msgstr "Uma configuração da mesa: o anfitrião pode mudar isso. Veja Jogando online → Configurações da mesa."

