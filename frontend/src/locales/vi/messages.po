msgctxt "clock table row"
msgid "Expansion hand decisions"
msgstr "Quyết định tay thẻ (mở rộng)"

#: src/routes/HowToPlay.tsx:4275
msgctxt "clock table row"
msgid "Expansion one-tap picks"
msgstr "Chọn một chạm (mở rộng)"

