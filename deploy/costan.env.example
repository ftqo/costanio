# Backend NON-SECRET config: a TEMPLATE. Copy it to the server and fill it in:
#
#   sudo install -m 644 -o root -g root deploy/costan.env.example /etc/costan/costan.env
#   sudoedit /etc/costan/costan.env
#
# The systemd unit reads it via EnvironmentFile=/etc/costan/costan.env. It lives
# outside the checkout, so `git pull` never touches it.
#
# Everything here is public (it appears in OAuth URLs / signature
# verification). Secrets do not go here: the three secrets
# (discord_client_secret, google_client_secret, discord_bot_token) live
# SOPS-encrypted in /etc/costan/secrets.enc.yaml and are decrypted into tmpfs at
# startup.
#
# COSTAN_ADDR, COSTAN_DB, COSTAN_SECURE_COOKIES, COSTAN_REAL_IP_HEADER, and the
# *_SECRET_FILE / *_TOKEN_FILE paths are set in deploy/costan.service, not here.
# Frontend/Pages vars (ORIGIN_BASE, VITE_DISCORD_CLIENT_ID) are Cloudflare Pages
# settings, optionally committed via wrangler.toml (see DEPLOY.md §2), not here.

# ── Required ────────────────────────────────────────────────────────────────
# Public origin (browser-facing). Builds OAuth redirect URIs and the websocket
# Origin allowlist. Must equal the apex the Pages site serves (no www, no slash).
COSTAN_BASE_URL=https://example.com

# OAuth client IDs (public; the matching secrets are in /etc/costan/secrets.enc.yaml).
# At least one provider (Discord and/or Google) must be configured to allow login.
# Discord login requests only the `identify` scope. Redirect: /auth/discord/callback
DISCORD_CLIENT_ID=<your Discord application id>
# Redirect: /auth/google/callback. Scopes: openid email profile.
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# ── Optional: Discord Activity (in-Discord embed) ───────────────────────────
# Application ID (same value as DISCORD_CLIENT_ID). Allows the *.discordsays.com
# iframe origin + enables /setrole command auto-registration.
COSTAN_DISCORD_APP_ID=<your Discord application id>

# ── Optional: supporter sync ────────────────────────────────────────────────
# Bot token is a SECRET -> /etc/costan/secrets.enc.yaml. The guild id is not secret:
DISCORD_GUILD_ID=<your Discord server id>
# roleID:kind comma list, e.g. 111:subscription,222:boost,333:gift,444:kofi,555:staff
# Valid kinds: subscription|boost|gift|kofi|staff. A MALFORMED value crashes boot.
DISCORD_SUPPORTER_ROLE_IDS=

# ── Optional: /setrole slash commands ───────────────────────────────────────
# The app's Ed25519 public key (hex). Verifies Discord's signatures; not a secret.
# Interactions Endpoint URL to register: https://example.com/discord/interactions
DISCORD_PUBLIC_KEY=<your application's public key, hex>

# ── Optional: ops ───────────────────────────────────────────────────────────
# COSTAN_LOG_LEVEL=INFO        # DEBUG|INFO|WARN|ERROR
# COSTAN_BOT_DELAY=1500ms      # pause before each bot action (0 = instant)
# COSTAN_GAME_IDLE_EVICT=5m    # unload an idle game from memory (0 = never)
# COSTAN_GAME_EVENT_CAP=8000   # force-end a game past this many events (0 = no cap)

# ── FIRST BOOT ONLY ─────────────────────────────────────────────────────────
# In production the server refuses to create a missing database, since an empty
# site passes every health check (see DEPLOY.md §5). On the very first start,
# uncomment this, start the service, then comment it out again and restart.
# While it is set every start logs a warning.
# COSTAN_ALLOW_NEW_DB=1

# ── Never set in production ─────────────────────────────────────────────────
# COSTAN_DEV_AUTH, COSTAN_LOADTEST, COSTAN_PPROF: dev/test only. All three are
# refused (with a warning) when COSTAN_SECURE_COOKIES is set or COSTAN_BASE_URL
# is https.

# Backup and alert settings are not here: they belong to costan-backup.service and
# costan-alert@.service, which read /etc/costan/backup.env
# (COSTAN_ALERT_CHANNEL_ID, BACKUP_KEEP_DAYS, BACKUP_RCLONE_REMOTE). See §10.
